{
  "name": "@common-benefits/website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @common-benefits/core run typespec && pnpm run typespec && astro dev",
    "start": "pnpm run dev",
    "build": "pnpm --filter @common-benefits/core run typespec && pnpm run typespec && astro build",
    "preview": "astro preview",
    "preview:wrangler": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "astro": "astro",
    "typespec:clear": "rm -rf tsp-output public/schemas/yaml public/openapi",
    "typespec:compile": "tsp compile src/specs/main.tsp",
    "typespec:copy": "mkdir -p public/schemas/yaml public/openapi && cp -R tsp-output/@typespec/json-schema/. public/schemas/yaml/ && cp -R tsp-output/@typespec/openapi3/. public/openapi/",
    "typespec": "pnpm run typespec:clear && pnpm run typespec:compile && pnpm run typespec:copy",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "check:lint": "eslint",
    "check:format": "prettier --check .",
    "check:astro": "astro check",
    "check:types": "astro sync && tsc --noEmit",
    "checks": "pnpm run check:lint && pnpm run check:format && pnpm run check:types && pnpm run check:astro",
    "ci": "pnpm run checks && pnpm run build && pnpm run test",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.3.5",
    "@astrojs/starlight": "^0.39.2",
    "astro": "^6.3.7",
    "js-yaml": "^4.1.0",
    "json-schema-merge-allof": "^0.8.1",
    "openapi-sampler": "^1.7.3",
    "sharp": "^0.34.5",
    "starlight-links-validator": "^0.24.0",
    "swagger-ui-dist": "^5.32.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "catalog:",
    "@common-benefits/core": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/js-yaml": "^4.0.9",
    "@types/json-schema-merge-allof": "^0.6.5",
    "@types/node": "catalog:",
    "@types/swagger-ui-dist": "^3.30.6",
    "@typespec/compiler": "catalog:",
    "@typespec/json-schema": "catalog:",
    "@typespec/openapi3": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
