---
import { Tabs, TabItem, Code } from "@astrojs/starlight/components";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { Paths } from "@/lib/paths";
import { findSchema } from "@/lib/protocol-catalog";
import { generateSchemaExample } from "@/lib/schema/example-generator";
import { SchemaLoader } from "@/lib/schema/schema-loader";
import { extractTypeSpecDeclaration } from "@/lib/typespec-extractor";

export interface Props {
  schema: string;
}

const { schema } = Astro.props;
const found = findSchema(schema);

if (!found) {
  throw new Error(
    `<SchemaFormatTabs schema="${schema}" />: schema is not registered in protocol-catalog.ts. ` +
      `Add an entry to src/lib/protocol-catalog.ts.`
  );
}

const source = found.entry.source;
const schemaYaml = SchemaLoader.loadResolvedYamlByName(schema);
const typeSpecSource =
  source.kind === "typespec"
    ? (extractTypeSpecDeclaration(
        readFileSync(join(Paths.REPO_ROOT, source.sourcePath), "utf-8"),
        schema
      ) ?? `// ${schema} not found in ${source.sourcePath}`)
    : null;

// Fail the build loudly on example-generation errors: log the full error to
// the console and rethrow with the schema name, rather than rendering a broken
// placeholder into the page.
const example = await generateSchemaExample(schema).catch((error: unknown) => {
  console.error(`Failed to generate example for schema "${schema}":`, error);
  throw new Error(
    `Failed to generate example for schema "${schema}": ${
      error instanceof Error ? error.message : String(error)
    }`,
    { cause: error instanceof Error ? error : undefined }
  );
});
---

<Tabs>
  <TabItem label="Example">
    <Code code={example} lang="json" />
  </TabItem>
  <TabItem label="JSON Schema">
    <Code code={schemaYaml} lang="yaml" />
  </TabItem>
  {
    typeSpecSource && (
      <TabItem label="TypeSpec">
        <Code code={typeSpecSource} lang="typespec" />
      </TabItem>
    )
  }
</Tabs>
