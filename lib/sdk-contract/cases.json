  "cases": [
    {
      "name": "widget-get-ok",
      "description": "get returns a single item in an Ok envelope",
      "call": { "resource": "widgets", "verb": "get", "id": "11111111-1111-1111-1111-111111111111" },
      "expectedRequest": {
        "method": "GET",
        "path": "/widgets/11111111-1111-1111-1111-111111111111",
        "body": null
      },
      "response": {
        "status": 200,
        "body": {
          "status": 200,
          "message": "ok",
          "data": {
            "id": "11111111-1111-1111-1111-111111111111",
            "name": "Red widget",
            "color": "red",
            "weight": 5.0,
            "customFields": {
              "legacyRef": {
                "name": "legacy_ref",
                "fieldType": "object",
                "value": { "system": "legacy", "id": 7 }
              },
              "category": { "name": "category", "fieldType": "string", "value": "eco" }
            }
          }
        }
      },
      "expectedResult": { "okCount": 1, "errorCount": 0 }
    },
    {
      "name": "widget-list-isolates-bad-row",
      "description": "list parses a page and isolates one malformed row as a per-row error",
      "call": { "resource": "widgets", "verb": "list", "page": 1 },
      "expectedRequest": { "method": "GET", "path": "/widgets", "body": null },
      "response": {
        "status": 200,
        "body": {
          "status": 200,
          "message": "ok",
          "items": [
            {
              "id": "11111111-1111-1111-1111-111111111111",
              "name": "Red widget",
              "color": "red",
              "weight": 5.0,
              "customFields": null
            },
            { "id": "22222222-2222-2222-2222-222222222222", "name": "Broken" }
          ],
          "paginationInfo": { "page": 1, "pageSize": 2, "totalItems": 2, "totalPages": 1 },
          "sortInfo": { "sortBy": "name", "sortOrder": "asc" },
          "filterInfo": { "filters": {}, "errors": [] }
        }
      },
      "expectedResult": { "okCount": 1, "errorCount": 1 }
    },
    {
      "name": "widget-search-standard-and-custom",
      "description": "search splits standard keys (color, weight) to top level and unknown keys (region) to customFilters",
      "call": {
        "resource": "widgets",
        "verb": "search",
        "filters": {
          "color": { "operator": "eq", "value": "red" },
          "weight": { "operator": "between", "value": { "min": 1, "max": 10 } },
          "region": { "operator": "in", "value": ["PA", "NJ"] }
        }
      },
      "categorization": { "topLevel": ["color", "weight"], "customFilters": ["region"] },
      "expectedRequest": {
        "method": "POST",
        "path": "/widgets/search",
        "body": {
          "filters": {
            "color": { "operator": "eq", "value": "red" },
            "weight": { "operator": "between", "value": { "min": 1, "max": 10 } },
            "customFilters": { "region": { "operator": "in", "value": ["PA", "NJ"] } }
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": 200,
          "message": "ok",
          "items": [
            {
              "id": "11111111-1111-1111-1111-111111111111",
              "name": "Red widget",
              "color": "red",
              "weight": 5.0,
              "customFields": null
            },
            { "id": "22222222-2222-2222-2222-222222222222", "name": "Broken" }
          ],
          "paginationInfo": { "page": 1, "pageSize": 2, "totalItems": 2, "totalPages": 1 },
          "sortInfo": { "sortBy": "name", "sortOrder": "asc" },
          "filterInfo": {
            "filters": { "color": { "operator": "eq", "value": "red" } },
            "errors": []
          }
        }
      },
      "expectedResult": { "okCount": 1, "errorCount": 1 }
    },
    {
      "name": "widget-search-passthrough-no-plugin",
      "description": "an unregistered custom filter passes through to customFilters even with no plugin",
      "call": {
        "resource": "widgets",
        "verb": "search",
        "filters": { "region": { "operator": "in", "value": ["PA"] } }
      },
      "categorization": { "topLevel": [], "customFilters": ["region"] },
      "expectedRequest": {
        "method": "POST",
        "path": "/widgets/search",
        "body": {
          "filters": { "customFilters": { "region": { "operator": "in", "value": ["PA"] } } }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": 200,
          "message": "ok",
          "items": [
            {
              "id": "11111111-1111-1111-1111-111111111111",
              "name": "Red widget",
              "color": "red",
              "weight": 5.0,
              "customFields": null
            }
          ],
          "paginationInfo": { "page": 1, "pageSize": 1, "totalItems": 1, "totalPages": 1 },
          "sortInfo": { "sortBy": "name", "sortOrder": "asc" },
          "filterInfo": { "filters": {}, "errors": [] }
        }
      },
      "expectedResult": { "okCount": 1, "errorCount": 0 }
    },
    {
      "name": "gadget-search-standard-and-custom",
      "description": "gadget search routes the standard 'size' comparison to top level and an unknown 'vendor' to customFilters",
      "call": {
        "resource": "gadgets",
        "verb": "search",
        "filters": {
          "size": { "operator": "gt", "value": 10 },
          "vendor": { "operator": "eq", "value": "acme" }
        }
      },
      "categorization": { "topLevel": ["size"], "customFilters": ["vendor"] },
      "expectedRequest": {
        "method": "POST",
        "path": "/gadgets/search",
        "body": {
          "filters": {
            "size": { "operator": "gt", "value": 10 },
            "customFilters": { "vendor": { "operator": "eq", "value": "acme" } }
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": 200,
          "message": "ok",
          "items": [
            {
              "id": "33333333-3333-3333-3333-333333333333",
              "label": "Large gadget",
              "size": 42.0,
              "customFields": null
            }
          ],
          "paginationInfo": { "page": 1, "pageSize": 1, "totalItems": 1, "totalPages": 1 },
          "sortInfo": { "sortBy": "label", "sortOrder": "asc" },
          "filterInfo": { "filters": { "size": { "operator": "gt", "value": 10 } }, "errors": [] }
        }
      },
      "expectedResult": { "okCount": 1, "errorCount": 0 }
    },
    {
      "name": "gadget-history-distinct-verb",
      "description": "history is a second filterable verb with its own standard filter (actor) plus a non-filter 'since' body field",
      "call": {
        "resource": "gadgets",
        "verb": "history",
        "since": "2026-01-01T00:00:00Z",
        "filters": {
          "actor": { "operator": "eq", "value": "alice" },
          "channel": { "operator": "eq", "value": "web" }
        }
      },
      "categorization": { "topLevel": ["actor"], "customFilters": ["channel"] },
      "expectedRequest": {
        "method": "POST",
        "path": "/gadgets/history",
        "body": {
          "since": "2026-01-01T00:00:00Z",
          "filters": {
            "actor": { "operator": "eq", "value": "alice" },
            "customFilters": { "channel": { "operator": "eq", "value": "web" } }
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": 200,
          "message": "ok",
          "items": [
            {
              "id": "33333333-3333-3333-3333-333333333333",
              "label": "Large gadget",
              "size": 42.0,
              "customFields": null
            }
          ],
          "paginationInfo": { "page": 1, "pageSize": 1, "totalItems": 1, "totalPages": 1 },
          "sortInfo": { "sortBy": "label", "sortOrder": "asc" },
          "filterInfo": { "filters": { "actor": { "operator": "eq", "value": "alice" } }, "errors": [] }
        }
      },
      "expectedResult": { "okCount": 1, "errorCount": 0 }
